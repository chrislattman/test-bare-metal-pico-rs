{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rust: Remote Attach",
            "type": "gdb",
            "request": "attach",
            "executable": "${workspaceFolder}/target/thumbv8m.main-none-eabi/debug/test-bare-metal-pico-rs",
            "cwd": "${workspaceFolder}",
            "target": "localhost:1234",
            "remote": true,
            "gdbpath": "${userHome}/.cargo/bin/rust-gdb",
            "env": {
                "RUST_GDB": "gdb-multiarch"
            }
        }
    ]
}